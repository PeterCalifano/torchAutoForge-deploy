# ptafdeploy model config v1
# Place or keep the YOLOv7 sample in the canonical repo-local model tree.
# The model binary is large and may be absent from fresh clones.
schema_version = 1
artifact_path = ../../models/onnx/yolov7_640x640.onnx
role = object_detection
preprocessing = image_tensor_nchw_rgb_640
postprocessing = yolov7_raw_detection_tensor
backend = onnxruntime
artifact = onnx
execution_target_priority = cuda,cpu
allow_fallback = true
device_id = 0
